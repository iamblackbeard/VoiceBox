{
  "name": "local-voice-reader",
  "description": "Reads selected web text aloud with a local voice. Nothing leaves your machine.",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "wxt",
    "dev:firefox": "wxt -b firefox --mv3",
    "build": "wxt build",
    "build:firefox": "wxt build -b firefox --mv3",
    "compile": "tsc --noEmit",
    "postinstall": "wxt prepare",
    "test": "vitest run"
  },
  "dependencies": {
    "@mintplex-labs/piper-tts-web": "^1.0.5",
    "kokoro-js": "^1.2.1",
    "onnxruntime-web": "^1.30.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@diffusionstudio/piper-wasm": "^1.0.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@wxt-dev/module-react": "^1.2.2",
    "tailwindcss": "^4.3.3",
    "typescript": "~6.0.2",
    "vitest": "^3.2.7",
    "wxt": "^0.21.4"
  }
}
